meta {
  name: Create execution node
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/engine/nodes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

body:json {
  {
    "Name": "Send hangup message to reporter",
    "Description": "This execution node holds actions to send message to reporter on continuing the incident handling.",
    "Type": "ExecutionNode",
    "ParentNodeId": "{{MAIN_QN2_ID}}",
    "SchemaId": "{{MAIN_SCHEMA_ID}}",
    "Actions": [
      {
        "Type": "SendMessage",
        "Name": "Send hangup message - To reporter",
        "Description": "Sending incident handling continued message",
        "Sequence": 0,
        "Input": {
          "Params": [
            {
              "Type": "Phone",
              "Value": null,
              "Source": "Almanac",
              "Key": "ContextParams:Reporter:Phone"
            },
            {
              "Type": "Text",
              "Name": "Message",
              "Value": "Please hang in there. In the meantime call 108 for ambulance assistance"
            },
            {
              "Name": "Incident code",
              "Type": "Placeholder",
              "Key": "ContextParams:IncidenceCode",
              "Source": "Almanac"
            }
          ]
        }
      },
        {
        "Type": "TriggerTimerNode",
        "Name": "Trigger timer node - Incident Resolution",
        "Sequence": 1,
        "Description": "This action triggers a timer node which handles incident resolution workflow.",
        "Input": {
          "Params": [
            {
              "Name": "T1 CFR -Check Resolution Timer node",
              "Description": "Node Id of the timer node which should be triggered",
              "ActionType": "TriggerTimerNode",
              "Type": "NodeId",
              "Value": "{{MAIN_TN1_ID_}}",
              "Key": "IncidentResolutionTimerNode",
              "Required": true
            }
          ]
        }
      } 
    
    ]
  }
}

script:post-response {
  let status = res.getStatus();
  console.log(status)
  if (status == 201) {
    bru.setEnvVar("MAIN_EN10_CFR_REACHED_ID", res.body.Data.id);
  }
  
}

tests {
  test("Request is successfull", function () {
      expect(res.getStatus()).to.equal(201);
      var jsonRes = res.getBody();
      expect(jsonRes.Status).to.eql('success');
  });
  
  test("Execution node is created", function () {
      var jsonRes = res.getBody();
      expect(jsonRes.Data).to.have.property('id');
      expect(jsonRes.Data).to.have.property('Name');
      expect(jsonRes.Data).to.have.property('Description');
  });
  
}

docs {
  User login with username/phone/email and password.
  
  'LoginRoleId' is the role id through which user wants to log into the system provided the user has the role.
}
