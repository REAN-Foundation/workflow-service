meta {
  name: Create execution node - CFR timer closer msg
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/engine/nodes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

body:json {
  {
    "Name": "Send CFR timer closure message",
    "Description": "This execution node holds actions to send message to CFR telling no response was given within timer period hence flow has terminated.",
    "Type": "ExecutionNode",
    "ParentNodeId": null,
    "SchemaId": "{{MAIN_SCHEMA_ID}}",
    "Actions": [
      {
        "Type": "SendOneMessageToMultipleUsers",
        "Name": "Send message - CFR Phone",
        "Description": "Sending closing message.",
        "Sequence": 1,
        "Input": {
          "Params": [
            {
              "Name": "List of CFR phonenumbers",
              "Type": "Array",
              "Value": null,
              "Source": "Almanac",
              "Key": "ContextParams:CFR:Phonenumbers",
              "SubType": "Phone"
            },
            {
              "Type": "Text",
              "Name": "Message",
              "Value": "This request is closed because of no response for long time. We hope the incident has been handled. Thank you."
            }
          ]
        }
      }
     
    ]
  }
}

script:post-response {
  let status = res.getStatus();
  console.log(status)
  if (status == 201) {
    bru.setEnvVar("CLOSER_MSG_CFR", res.body.Data.id);
  }
  
}

tests {
  test("Request is successfull", function () {
      expect(res.getStatus()).to.equal(201);
      var jsonRes = res.getBody();
      expect(jsonRes.Status).to.eql('success');
  });
  
  test("Execution node is created", function () {
      var jsonRes = res.getBody();
      expect(jsonRes.Data).to.have.property('id');
      expect(jsonRes.Data).to.have.property('Name');
      expect(jsonRes.Data).to.have.property('Description');
  });
  
}

docs {
  User login with username/phone/email and password.
  
  'LoginRoleId' is the role id through which user wants to log into the system provided the user has the role.
}
