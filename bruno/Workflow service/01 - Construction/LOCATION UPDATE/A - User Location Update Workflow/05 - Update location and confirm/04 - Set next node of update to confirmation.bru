meta {
  name: 04 - Set next node of update to confirmation
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/engine/nodes/{{UPDATE_LOCATION_NODE_ID}}/next-node/{{CONFIRM_NODE_ID}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

tests {
  test("Request is successful", function () {
    expect(res.getStatus()).to.equal(200);
    var jsonRes = res.getBody();
    expect(jsonRes.Status).to.eql('success');
  });
}

docs {
  Links EN2 (Update Location API) to EN3 (Confirmation SendMessage).
  After EN2's RestApiCall returns 200 (location service confirmed update),
  the workflow advances to EN3 to inform the user.
}
