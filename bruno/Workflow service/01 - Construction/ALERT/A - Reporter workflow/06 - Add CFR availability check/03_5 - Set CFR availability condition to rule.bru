meta {
  name: 03_5 - Set CFR availability condition to rule
  type: http
  seq: 5
}

put {
  url: {{BASE_URL}}/engine/rules/{{CFR_AVAILABILITY_CHECK_RULE_ID}}/base-condition/{{CFR_AVAILABILITY_CHECK_BASE_CONDITION_ID}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

tests {
  test("Request is successfull", function () {
      expect(res.getStatus()).to.equal(200);
      var jsonRes = res.getBody();
      expect(jsonRes.Status).to.eql('success');
  });
}

docs {
  Set CFR availability check condition to the rule.
  
  This assigns the base condition to the CFR availability check rule.
}
