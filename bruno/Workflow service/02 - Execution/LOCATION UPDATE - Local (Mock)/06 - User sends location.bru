meta {
  name: 06 - User sends location
  type: http
  seq: 6
}

post {
  url: {{BASE_URL}}/engine/events/user-message
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

body:json {
  {
    "TenantId": "{{TENANT_ID}}",
    "SchemaId": "{{SCHEMA_ID}}",
    "SchemaInstanceId": "{{LOCATION_UPDATE_SCHEMA_INSTANCE_ID}}",
    "EventType": "UserMessage",
    "EventTimestamp": "{{TIMESTAMP}}",
    "UserMessage": {
      "Phone": "{{USER_PHONE}}",
      "EventTimestamp": "{{TIMESTAMP}}",
      "MessageType": "Location",
      "MessageChannel": "WhatsApp",
      "Location": {
        "Latitude": 18.5074,
        "Longitude": 73.8077
      }
    }
  }
}

script:pre-request {
  const nowStr = new Date().toISOString();
  bru.setEnvVar("TIMESTAMP", nowStr);
}

script:post-response {
  let status = res.getStatus();
  console.log(status);
  if (status == 201) {
    bru.setEnvVar("LOCATION_EVENT_ID", res.body.Data.id);
  }
}

tests {
  test("Request is successful", function () {
    expect(res.getStatus()).to.equal(201);
    var jsonRes = res.getBody();
    expect(jsonRes.Status).to.eql('success');
  });

  test("Location event is created", function () {
    var jsonRes = res.getBody();
    expect(jsonRes.Data).to.have.property('id');
  });
}

docs {
  Sends the user's location (Pune city centre by default) with MessageChannel = "Mock".
  LN1 stores it to the almanac; the location-check advances to EN2 (external PUT /responders),
  then EN3 sends "Your location has been successfully updated. Thank you!" — captured by the
  Mock provider. Verify with "07 - Get captured messages (confirmation)".
}
