meta {
  name: 02 - Get routing prompt
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/engine/schema/{{MAIN_SCHEMA_ID}}/routing-prompt
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

script:post-response {
  let status = res.getStatus();
  console.log(status)
  if (status == 200) {
    console.log("Routing Prompt:", res.body.Data.RoutingPrompt);
  }
  
}

tests {
  test("Request is successful", function () {
      expect(res.getStatus()).to.equal(200);
      expect(res.body.Status).to.eql('success');
  });
  
  test("Routing prompt is returned", function () {
      var jsonRes = res.getBody();
      expect(jsonRes.Data).to.have.property('RoutingPrompt');
  });
  
}

docs {
  Retrieves the routing prompt for a specific schema.
  
  The routing prompt helps identify schema characteristics and can be used for:
  - AI-based workflow routing
  - Schema classification
  - Workflow discovery
  
  Returns null if no routing prompt has been set.
}
