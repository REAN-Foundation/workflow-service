meta {
  name: 01 - Create schema
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/engine/schema
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

body:json {
  {
    "TenantId": "{{TENANT_ID}}",
    "TenantCode": "{{TENANT_CODE}}",
    "Name": "Alert Report Workflow - V1",
    "Description": "This schema represents a workflow for ALERT emergency response management.",
    "Type": "ChatBot",
    "RoutingPrompt": "Route here when a user reports or responds to an urgent health emergency requiring immediate assistance, including incidents such as accidents, attacks, getting lost, or explicitly asking for help. Trigger phrases may include messages like 'help', 'Help me', 'I need help', 'accident', 'attack', 'i am lost', 'Yes, need help', as well as operational status replies such as 'Available', 'Not Available', 'Didnt allow', 'Other reasons', 'Victim shifted', and 'Ambulance arrived'. This workflow handles emergency alert coordination with community first responders (CFRs), including location-based CFR dispatch, timer-based escalation, ambulance coordination, and incident resolution tracking within a 90-minute response window.\n\nSPECIAL CASE — BUTTON REPLIES TO THIS WORKFLOW'S CONFIRMATION PROMPT: The phrases 'Yes, need help' and 'No, not now' are button labels from this workflow's own confirmation prompt. When the user sends EITHER of these EXACT phrases, ALWAYS match this workflow and set requiredConfirmation to false. The workflow's internal logic handles both acceptance and rejection. Do NOT treat 'No, not now' as a refusal to engage; it must still route here so the workflow can send the correct acknowledgement response.\n\nCONFIRMATION_REQUIRED: true. When this workflow is selected as the matched workflow AND the user message is NOT one of the special-case button replies listed above, the classifier MUST set \"requiredConfirmation\": \"true\" in its JSON response. Emergency response is high-stakes, and ambiguous messages such as 'Yes', 'No', or 'help' must first go through a confirmation prompt like 'Are you in an emergency and need immediate assistance?' before starting the workflow. Do NOT set requiredConfirmation to false for any workflow match other than the explicit special-case button replies.",
    "ContextParams": {
      "Name": "Schema instance context",
      "Params": [
        {
          "Name": "Reporter Phone",
          "Type": "Phone",
          "Description": "This is phone number of person reporting an emergency incident",
          "Value": null,
          "Key": "ContextParams:Reporter:Phone",
          "Required": true
        },
        {
          "Name": "Location",
          "Description": "This is the location where the emergency has occurred.",
          "Type": "Location",
          "Value": {
            "Longitude": null,
            "Latitude": null
          },
          "Key": "ContextParams:Location",
          "Required": false,
          "ComparisonThreshold": 250,
          "ComparisonUnit": "m"
        },
        {
          "Name": "Timestamp",
          "Description": "This is the timestamp the emergency has been reported.",
          "Type": "DateTime",
          "Value": null,
          "Key": "ContextParams:Timestamp",
          "Required": false,
          "ComparisonThreshold": 12,
          "ComparisonUnit": "h"
        },
        {
          "Name": "Schema Instance Code",
          "Description": "This is the code of the schema instance",
          "Type": "Text",
          "Value": null,
          "Key": "SchemaInstanceCode"
        },
        {
          "Name": "Incidence Code",
          "Description": "This is the code of the reported emergency incident. This value is generated on schema instance generation",
          "Type": "Text",
          "Value": null,
          "Key": "ContextParams:IncidenceCode"
        },
        {
          "Name": "Time Zone",
          "Description": "Time Zone for the workflow",
          "Type": "Timezone",
          "Value": "Asia/Kolkata",
          "Key": "ContextParams:Timezone"
        },
        {
          "Name": "Locale",
          "Description": "Locale for the workflow",
          "Type": "Locale",
          "Value": "en-IN",
          "Key": "ContextParams:Locale"
        }
      ]
    }
  }
}

script:post-response {
  let status = res.getStatus();
  console.log(status)
  if (status == 201) {
    bru.setEnvVar("MAIN_SCHEMA_ID", res.body.Data.id);
    bru.setEnvVar("BASE_SCHEMA_ID", res.body.Data.id);
    bru.setEnvVar("MAIN_ROOT_NODE_ID", res.body.Data.RootNode.id);
  }
  
}

tests {
  test("Request is successfull", function () {
      expect(res.getStatus()).to.equal(201);
      expect(res.body.Status).to.eql('success');
  });
  
  test("Schema is created", function () {
      var jsonRes = res.getBody();
      expect(jsonRes.Data).to.have.property('id');
      expect(jsonRes.Data).to.have.property('TenantId');
      expect(jsonRes.Data).to.have.property('Name');
      expect(jsonRes.Data).to.have.property('Description');
      expect(jsonRes.Data).to.have.property('RootNode');
  });
  
}

docs {
  User login with username/phone/email and password.
  
  'LoginRoleId' is the role id through which user wants to log into the system provided the user has the role.
}
