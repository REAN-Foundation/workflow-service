meta {
  name: 06 - Set next node of confirmation to success terminator
  type: http
  seq: 6
}

put {
  url: {{BASE_URL}}/engine/nodes/{{CONFIRM_NODE_ID}}/next-node/{{TERMINATOR_SUCCESS_ID}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

tests {
  test("Request is successful", function () {
    expect(res.getStatus()).to.equal(200);
    var jsonRes = res.getBody();
    expect(jsonRes.Status).to.eql('success');
  });
}

docs {
  Links EN3 (Confirmation SendMessage) to TN_SUCCESS (Terminator).
  Completes the success path:
    LN1  ->  YNN1 (yes)  ->  EN2 (RestApiCall PUT)  ->  EN3 (SendMessage)  ->  TN_SUCCESS  (Terminated=true)

  Only reached if EN3's SendMessage actually succeeds (chatbot accepts the call).
  If it fails, the workflow stalls at EN3 and the 5-minute timer terminates via TN_TIMEOUT.
}
