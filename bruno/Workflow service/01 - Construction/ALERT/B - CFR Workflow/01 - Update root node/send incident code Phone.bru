meta {
  name: send incident code Phone
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/engine/node-actions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

body:json {
   {
      "Type": "SendMessage",
      "Name": "Send incident code to CFR",
      "Description": "Send emergency incident code to the CFR",
      "Sequence": 3,
      "ParentNodeId": "{{CHILD_MAIN_ROOT_NODE_ID}}",
      "Input": {
        "Params": [
          {
            "Type": "Phone",
            "Value": null,
            "Source": "Almanac",
            "Key": "ContextParams:CFR:Phone"
          },
          {
            "Name": "Incident report Message",
            "Type": "Text",
            "Value": "The emergency incident code is {{ContextParams:IncidenceCode}}, and contact number of incident reporter is {{ContextParams:Reporter:Phone}}"
          },
          {
            "Name": "Incident code",
            "Type": "Placeholder",
            "Key": "ContextParams:IncidenceCode",
            "Source": "Almanac"
          },
           {
            "Name": "Reporter Phone",
            "Type": "Placeholder",
             "Key": "ContextParams:Reporter:Phone",
            "Source":"Almanac"
          }      
        ]
      }
    }
  
  
}

tests {
  {
    test("Request is successfull", function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test("Action is added", function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data).to.have.property('Name');
    });
  
  }
  
}
