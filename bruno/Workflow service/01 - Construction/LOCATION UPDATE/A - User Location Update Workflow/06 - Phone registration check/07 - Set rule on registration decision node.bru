meta {
  name: 07 - Set rule on registration decision node
  type: http
  seq: 7
}

put {
  url: {{BASE_URL}}/engine/nodes/{{YNN2_ID}}/base-rule/{{REG_RULE_ID}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

tests {
  test("Request is successful", function () {
    expect(res.getStatus()).to.equal(200);
    var jsonRes = res.getBody();
    expect(jsonRes.Status).to.eql('success');
  });
}

docs {
  Attaches the responder registration check rule to YNN2 as its base rule.
  The engine's traverseLogicalYesNoActionNode reads this rule to decide yes vs no.
}
