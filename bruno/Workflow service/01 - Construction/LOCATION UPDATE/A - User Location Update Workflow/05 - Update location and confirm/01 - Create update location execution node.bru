meta {
  name: 01 - Create update location execution node
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/engine/nodes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

body:json {
  {
    "Name": "EN2 - Update Location in Location Service",
    "Description": "Calls the location service REST API to update the active user's current latitude and longitude. Phone, Latitude, and Longitude are all resolved from the almanac at runtime - none of them are baked into the stored URL.",
    "Type": "ExecutionNode",
    "ParentNodeId": null,
    "SchemaId": "{{SCHEMA_ID}}",
    "Actions": [
      {
        "Type": "RestApiCall",
        "Name": "PUT - Update CFR location",
        "Sequence": 1,
        "Input": {
          "Params": [
            {
              "Type": "RestApiParams",
              "Value": {
                "Url": "https://h8zj79ud2i.execute-api.us-west-2.amazonaws.com/dev/api/v1/{{TENANT_ID}}/responders",
                "Method": "PUT",
                "Headers": {
                  "ContentType": "application/json"
                },
                "QueryParams": [
                  {
                    "QueryParamKey": "Phone",
                    "QueryParamValue": null,
                    "Source": "Almanac",
                    "SourceKey": "ContextParams:User:Phone"
                  },
                  {
                    "QueryParamKey": "Latitude",
                    "QueryParamValue": null,
                    "Source": "Almanac",
                    "SourceKey": "ContextParams:Location",
                    "SourceValueKey": "Latitude"
                  },
                  {
                    "QueryParamKey": "Longitude",
                    "QueryParamValue": null,
                    "Source": "Almanac",
                    "SourceKey": "ContextParams:Location",
                    "SourceValueKey": "Longitude"
                  }
                ],
                "ResponseField": "Data:CFR",
                "ResponseType": "Object"
              }
            }
          ]
        }
      }
    ]
  }
}

script:post-response {
  let status = res.getStatus();
  console.log(status);
  if (status == 201) {
    bru.setEnvVar("UPDATE_LOCATION_NODE_ID", res.body.Data.id);
  }
}

tests {
  test("Request is successful", function () {
    expect(res.getStatus()).to.equal(201);
    var jsonRes = res.getBody();
    expect(jsonRes.Status).to.eql('success');
  });
  
  test("Execution node is created", function () {
    var jsonRes = res.getBody();
    expect(jsonRes.Data).to.have.property('id');
    expect(jsonRes.Data).to.have.property('Name');
    expect(jsonRes.Data).to.have.property('Description');
  });
}

docs {
  Creates EN2 which makes a PUT REST API call to the location service to update the CFR location
  of the user currently interacting with the workflow.

  Endpoint at runtime:
    PUT /api/v1/{TENANT_ID}/responders?Phone=<X>&Latitude=<Y>&Longitude=<Z>

  IMPORTANT - why Phone is a QueryParam, NOT a URL path segment:
    The engine's RestApiCall implementation (action.executioner.ts) only resolves QueryParams
    from the almanac at runtime - the URL string itself is used verbatim from what was stored
    at construction time. If we put {{USER_PHONE}} in the URL path, Bruno would substitute
    that Bruno-env value at construction time and bake one specific phone into the stored URL.
    Every workflow instance would then call the same URL regardless of which user is actually
    on the conversation - wrong by design. By moving Phone to QueryParams with Source: Almanac,
    the engine reads ContextParams:User:Phone from the active instance's almanac at runtime,
    so the URL is per-user and correct.

    TENANT_ID stays as a Bruno-substituted value because the schema itself is per-tenant -
    the tenant doesn't change between instances of the same schema.

  Location service requirement:
    The location service controller must accept Phone from req.query (in addition to or instead
    of the legacy req.params.phone path segment). The route should also accept
    PUT /:tenantId/responders (without trailing /:phone). If the existing route is kept, add
    a sibling route, or have the controller read phone from params OR query.

  ResponseField is REQUIRED even though we don't need the response data. The engine's
  executeRestApiCallAction returns Success: false if `data` extracted from the response is null,
  regardless of HTTP status. Setting ResponseField to "Data:CFR" extracts the updated CFR object,
  which is non-null on success, so the action is marked Success and traversal continues to EN3.

  Captures UPDATE_LOCATION_NODE_ID for use in subsequent requests.
}
