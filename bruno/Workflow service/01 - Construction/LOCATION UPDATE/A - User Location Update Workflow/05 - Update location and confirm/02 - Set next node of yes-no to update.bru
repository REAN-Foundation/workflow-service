meta {
  name: 02 - Set next node of yes-no to update
  type: http
  seq: 2
}

put {
  url: {{BASE_URL}}/engine/nodes/{{YNN1_ID}}/next-node/{{UPDATE_LOCATION_NODE_ID}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  x-api-key: {{API_KEY}}
  Authorization: Bearer {{MODERATOR_USER_JWT}}
}

tests {
  test("Request is successful", function () {
    expect(res.getStatus()).to.equal(200);
    var jsonRes = res.getBody();
    expect(jsonRes.Status).to.eql('success');
  });
}

docs {
  Links YNN1 (decision node) to EN2 (update location API call).
  When YNN1's condition evaluates true (location exists in almanac), its
  Continue YesAction advances the workflow to EN2 via this next-node link.
}
